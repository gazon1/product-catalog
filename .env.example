# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the crawler's database.
#
# The storefront owns no schema and has no migration step. This connection is
# expected to be SELECT-only in Postgres — see README "Why read-only is
# enforced twice".
#
# Local dev (docker-compose.dev.yml):
#   postgresql://catalog:catalog@127.0.0.1:5433/product_catalog
# Production (VPS, real crawler database):
#   postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URL=postgresql://catalog:catalog@127.0.0.1:5433/product_catalog

# ---------------------------------------------------------------------------
# Required at build time only (baked into metadata)
# ---------------------------------------------------------------------------

# Public origin of the site. Used for absolute URLs in canonical tags,
# Open Graph, sitemap.xml and robots.txt. Getting this wrong ships a sitemap
# full of localhost URLs, which is valid output and completely useless.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Extra hosts the /product-image proxy may fetch, comma-separated, on top of
# the built-in upstream CDN list. Add a host here rather than editing the
# route when a new image domain appears in the crawled data.
# ALLOWED_IMAGE_HOSTS=cdn.example.com,images.example.net

# NODE_ENV=production
# PORT=3000