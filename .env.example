# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The crawler's catalog API, and the key that opens it.
#
# The storefront has no database credentials any more: it does not connect to
# PostgreSQL, it does not know the schema, and it cannot write. It reads the
# catalog the only way it is allowed to — over the crawler's read-only HTTP
# API, under a service-to-service key.
#
# CRAWLER_API_URL is the crawler's base URL. The API itself lives under the
# fixed prefix /api/catalog/v1, which the client appends.
#
# Local dev (docker-compose.dev.yml):
#   CRAWLER_API_URL=http://wb-parser:8080
# Production (VPS, the crawler next to the site):
#   CRAWLER_API_URL=http://wb-parser:8080
#
# The same address in both: the crawler publishes NO host port on purpose, so
# 127.0.0.1 is not it. The container answers on the shared `caddy_net` network
# under its own name, and the storefront is on that network too.
CRAWLER_API_URL=http://localhost:8080

# The key the crawler expects in the `X-Api-Key` header. It is the crawler's
# own CATALOG_API_KEY — the same value, in two places: the crawler is
# configured with it, the storefront is configured with it. The crawler accepts
# a comma-separated list, so a key can be rotated without downtime: the new
# key is added there first, this is switched over, and only then is the old key
# removed.
#
# The key never reaches the browser: the storefront fetches server-side and
# sends it as a header. It is not logged and it is not put in an error message.
CRAWLER_API_KEY=...

# ---------------------------------------------------------------------------
# Required at build time only (baked into metadata)
# ---------------------------------------------------------------------------

# Public origin of the site. Used for absolute URLs in canonical tags,
# Open Graph, sitemap.xml and robots.txt. Getting this wrong ships a sitemap
# full of localhost URLs, which is valid output and completely useless.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Extra hosts the /product-image proxy may fetch, comma-separated, on top of
# the built-in image CDN list. Add a host here rather than editing the
# route when a new image domain appears in the crawled data.
# ALLOWED_IMAGE_HOSTS=cdn.example.com,images.example.net

# NODE_ENV=production
# PORT=3000
